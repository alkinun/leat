# The box's front door: the app at https://{$LEAT_NAME}, the box's name, with a certificate Caddy
# has from Let's Encrypt by DNS-01, through the box's acme-dns account; and every plain HTTP request,
# as of http://leat.local or the box's address, sent there. leat agent listens on loopback behind it.
{
	admin off
	auto_https disable_redirects
	acme_ca {$LEAT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	http_port {$LEAT_HTTP_PORT:80}
	https_port {$LEAT_HTTPS_PORT:443}
}

{$LEAT_NAME} {
	tls {
		dns acmedns {$CREDENTIALS_DIRECTORY}/acme-dns.json
		# the challenge's lookups, of public resolvers: an office's router may refuse them, as a
		# router in Turkey answered its own data as REFUSED
		resolvers 1.1.1.1 9.9.9.9 8.8.8.8
		# no check of its own that the challenge's record is out, which asks leatbox.net's server
		# directly, as a network that takes DNS over never let it, a box in Turkey waiting in vain:
		# acme-dns has it at once, and Let's Encrypt checks it from its own servers
		propagation_delay 10s
		propagation_timeout -1
	}
	reverse_proxy 127.0.0.1:{$LEAT_AGENT_PORT:8000}
}

http:// {
	redir https://{$LEAT_NAME}{uri} 308
}
