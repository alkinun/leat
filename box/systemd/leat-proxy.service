[Unit]
Description=Leat's front door: the app over HTTPS at the box's name
Wants=network-online.target
After=network-online.target
# a box is served by its name, which provisioning gives it, on its first boot
After=leat-provision.service
ConditionPathExists=/etc/leat/box.env
# its identity, of its own partition, mounted before it is looked for
RequiresMountsFor=/etc/leat

[Service]
EnvironmentFile=/etc/leat/box.env
LoadCredential=acme-dns.json:/etc/leat/acme-dns.json
# its certificates and ACME account, kept with the box's identity, as tmpfiles.d/leat.conf makes it
Environment=XDG_DATA_HOME=/etc/leat/proxy XDG_CONFIG_HOME=/etc/leat/proxy
ExecStart=/usr/local/bin/leat-caddy run --config /usr/share/leat/box/Caddyfile --adapter caddyfile
Restart=on-failure
User=leat-proxy
Group=leat-proxy
ReadWritePaths=/etc/leat/proxy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
