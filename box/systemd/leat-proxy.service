[Unit]
Description=Leat's front door: the app over HTTPS at the box's name
Wants=network-online.target
After=network-online.target
# a box is served by its name, which provisioning gives it, on its first boot
After=leat-provision.service
ConditionPathExists=/etc/leat/box.env

[Service]
EnvironmentFile=/etc/leat/box.env
LoadCredential=acme-dns.json:/etc/leat/acme-dns.json
# its certificates and ACME account, kept where Caddy keeps its data
Environment=XDG_DATA_HOME=/var/lib/leat-proxy XDG_CONFIG_HOME=/var/lib/leat-proxy
ExecStart=/usr/local/bin/leat-caddy run --config /usr/share/leat/box/Caddyfile --adapter caddyfile
Restart=on-failure
DynamicUser=yes
StateDirectory=leat-proxy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
