[Unit]
Description=Put back what the box's system helper set: its time zone and fixed address
# kept on the state's partition, as an update replaced the system's and /run is lost at each boot:
# before anything tells the time by them
RequiresMountsFor=/var/lib
Before=leat-agent.service leat-screen.service
ConditionPathExists=/var/lib/leat-system

[Service]
Type=oneshot
ExecStart=/opt/leat/.venv/bin/python -m leat.box.system --restore

[Install]
WantedBy=multi-user.target
