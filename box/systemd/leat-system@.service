[Unit]
Description=The box's system, changed for leat agent: one request

[Service]
# as root, as setting the time zone, joining a Wi-Fi network, restarting or resetting the box and
# looking at its updates take it, for one request of leat agent's alone, which leat.box.system
# checks: nothing else of the system's is the helper's to touch
ExecStart=/opt/leat/.venv/bin/python -m leat.box.system
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutSec=30
NoNewPrivileges=yes
ProtectSystem=strict
# iwd's known networks, the ESP, of a factory reset's flag, networkd's runtime folder, of a fixed
# address, and what it keeps of what it set, the time zone's name and the fixed address
ReadWritePaths=/var/lib/iwd /boot /run/systemd/network
StateDirectory=leat-system
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
