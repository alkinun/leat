[Unit]
Description=Point the box's name at its address on the office's network
Wants=network-online.target
After=network-online.target
# a box is served by its name, which provisioning gives it, on its first boot
After=leat-provision.service
ConditionPathExists=/etc/leat/box.env

[Service]
Type=oneshot
LoadCredential=registry-secret:/etc/leat/registry-secret
ExecStart=/opt/leat/.venv/bin/python -m leat.box.address --state /var/lib/leat-address
DynamicUser=yes
StateDirectory=leat-address
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# at boot, as soon as the network is up, so that the name points at the box by the time anyone opens
# it, and again in 30 s if the registry cannot be reached; the timer tells it every 5 minutes after
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
