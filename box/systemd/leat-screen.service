[Unit]
Description=The box's screen: whether it is ready, and the address to open
# in place of a login on the box's display, which no box has
Conflicts=getty@tty2.service
After=systemd-user-sessions.service getty-pre.target leat-provision.service
# once the identity and the state are mounted, whose name and room it shows
After=etc-leat.mount var.mount

[Service]
# on a virtual console of its own, which the display shows, in a font read across a room, the kernel's
# and the boot's messages sent to the first, never written over it
ExecStartPre=+/opt/leat/.venv/bin/python -m leat.box.screen --take
ExecStart=/opt/leat/.venv/bin/python -m leat.box.screen
StandardInput=null
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty2
Restart=always
RestartSec=2
DynamicUser=yes
# the display's framebuffer, and its console; the power button, whose presses show a recovery code,
# and the helper that switches the box off, of a press again
SupplementaryGroups=video tty input leat
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
