[Unit]
Description=SearXNG: the web's search, for Leat, on this machine alone
Wants=network-online.target
After=network-online.target

[Service]
Environment=SEARXNG_SETTINGS_PATH=/usr/share/leat/searxng.yml
ExecStart=/usr/lib/leat/searxng
Restart=on-failure
RestartSec=2
DynamicUser=yes
StateDirectory=searxng
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
