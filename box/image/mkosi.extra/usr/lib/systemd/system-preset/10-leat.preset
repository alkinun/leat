# the box's services, on from its first boot
enable systemd-networkd.service
enable systemd-networkd-wait-online.service
enable systemd-resolved.service
enable systemd-timesyncd.service
enable leat-provision.service
enable leat-agent.service
enable leat-searxng.service
enable leat-proxy.service
enable leat-address.service
enable leat-address.timer
enable leat-screen.service
# no login on the box's display, whose screen leat-screen.service draws, nor on any other
disable getty@.service
