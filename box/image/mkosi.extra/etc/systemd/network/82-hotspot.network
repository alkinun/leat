# the box's own Wi-Fi, while it is a hotspot, as leat.box.hotspot opens one for want of a network:
# its address, which every name its devices ask its DNS for is, and theirs, each by DHCP
[Match]
WLANInterfaceType=ap

[Network]
Address=10.42.0.1/24
DHCPServer=yes
LinkLocalAddressing=no
IPv6AcceptRA=no

[DHCPServer]
PoolOffset=10
PoolSize=100
EmitDNS=yes
DNS=10.42.0.1
