# the box's identity, and its state, of their partitions unlocked, as /etc/crypttab says, once
# systemd-repart has made them on the first boot (systemd-cryptsetup@.service.d/leat.conf)
/dev/mapper/leat-identity  /etc/leat  ext4  defaults  0 2
/dev/mapper/leat-data      /var       ext4  defaults  0 2
